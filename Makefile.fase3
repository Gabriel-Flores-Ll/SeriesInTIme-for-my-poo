CXX      := g++
CXXFLAGS := -Wall -Wextra -Werror -pedantic -std=c++17 -g -Iinclude
VALGRIND := valgrind --leak-check=full --show-leak-kinds=all --track-origins=yes --error-exitcode=1

BUILD_DIR := build
TARGET    := $(BUILD_DIR)/test_fase3_b12

SRCS := src/DetectecEvent.cpp \
        src/PeakEvent.cpp \
        src/ThresholdEvent.cpp \
        src/StatisticalAnomalyEvent.cpp \
        src/EventRegistry.cpp

OBJS := $(patsubst src/%.cpp,$(BUILD_DIR)/%.o,$(SRCS))
TEST_OBJ := $(BUILD_DIR)/main_fase3_b12.o

.PHONY: all run valgrind clean

all: $(TARGET)

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

$(BUILD_DIR)/%.o: src/%.cpp | $(BUILD_DIR)
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(TEST_OBJ): tests/main_fase3_b12.cpp | $(BUILD_DIR)
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(TARGET): $(OBJS) $(TEST_OBJ)
	$(CXX) $(CXXFLAGS) $^ -o $@

run: $(TARGET)
	./$(TARGET)

valgrind: $(TARGET)
	$(VALGRIND) ./$(TARGET)

clean:
	rm -f $(OBJS) $(TEST_OBJ) $(TARGET)